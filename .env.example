# ============================================================
# BackupPC Docker — Environment variables
# Copy this file to .env and adjust the values.
# NEVER commit .env with passwords in production.
# ============================================================


# ── WebUI ───────────────────────────────────────────────────────────
WEBUI_USER=backuppc
WEBUI_PASSWORD=backuppc


# ── Rootless container runtimes ─────────────────────────────────────
# Set "true" for rootless container runtimes (e.g. Podman or Docker rootless)
# to allow ICMP (ping) for non-root users
ROOTLESS_RUNTIME=false


# ── Volumes ─────────────────────────────────────────────────────────
BACKUPPC_CONFIG_VOL=./data/backuppc/config
BACKUPPC_DATA_VOL=./data/backuppc/data
BACKUPPC_LOGS_VOL=./data/backuppc/logs


# ── Exposed ports ───────────────────────────────────────────────────
HTTP_PORT=80

# ── Timezone ────────────────────────────────────────────────────────
TZ=Europe/Paris